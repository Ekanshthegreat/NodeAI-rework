# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VITE_SUPABASE_STORAGE_BUCKET=maps
VITE_DEMO_EMAIL=demo@nodeai.com
VITE_DEMO_PASSWORD=demo123456

# WebSocket Telemetry Endpoint
VITE_TELEMETRY_WS=wss://your-telemetry-endpoint.com/ws

# Mock LLM Endpoint (for development)
VITE_LLM_ENDPOINT=http://localhost:8080/api/llm

# Site Configuration
VITE_DEFAULT_SITE_ID=warehouse_alpha

# Development
VITE_SHOW_DEV_PANEL=true